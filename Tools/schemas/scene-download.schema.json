{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lynook.local/schemas/scene-download.schema.json",
  "title": "SceneDownloadResult",
  "description": "scene-download.mjs 的 stdout 契约，与 C# SceneDownloadResult 对应。",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "splat": {
      "type": "string",
      "description": "下载到本地的 SPZ 绝对路径。"
    },
    "collider": {
      "type": "string",
      "description": "下载到本地的 GLB 绝对路径。"
    },
    "pano": {
      "type": ["string", "null"],
      "description": "可选全景图路径；批量录制不传 panoUrl 时该字段不存在。"
    },
    "splatBytes": { "type": "integer", "minimum": 0 },
    "colliderBytes": { "type": "integer", "minimum": 0 },
    "panoBytes": { "type": "integer", "minimum": 0 }
  },
  "required": ["splat", "collider", "splatBytes", "colliderBytes"]
}
